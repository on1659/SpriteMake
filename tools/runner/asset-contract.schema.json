{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SpriteMake asset contract",
  "type": "object",
  "required": [
    "schemaVersion",
    "assetId",
    "version",
    "target",
    "atlas",
    "qa",
    "reviews"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "assetId": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "target": {
      "type": "object",
      "required": [
        "finalPath"
      ],
      "properties": {
        "finalPath": {
          "type": "string",
          "pattern": "^final/"
        }
      }
    },
    "atlas": {
      "type": "object"
    },
    "qa": {
      "type": "object",
      "required": [
        "required",
        "thresholds"
      ],
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "thresholds": {
          "type": "object"
        },
        "requiredInputs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(source|generated|manifests|qa|contracts)/[^\\\\]+$"
          },
          "uniqueItems": true
        }
      }
    },
    "reviews": {
      "type": "object",
      "required": [
        "filenameContent",
        "style"
      ],
      "properties": {
        "filenameContent": {
          "type": "object",
          "properties": {
            "required": {
              "type": "boolean"
            }
          }
        },
        "motion": {
          "type": "object",
          "properties": {
            "required": {
              "type": "boolean"
            }
          }
        },
        "placement": {
          "type": "object",
          "properties": {
            "required": {
              "type": "boolean"
            }
          }
        },
        "style": {
          "type": "object",
          "properties": {
            "required": {
              "type": "boolean"
            },
            "comparisonRequired": {
              "type": "boolean"
            },
            "referencePath": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(source|generated|manifests|qa|contracts)/[^\\\\]+$"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "role"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(source|generated|manifests|qa|contracts)/[^\\\\]+$"
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "direction": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  }
}
